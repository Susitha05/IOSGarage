rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function roleOf() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }

    match /users/{uid} {
      allow read: if signedIn();                 // needed so customers can list garages; tighten with a public "garages" collection for production
      allow write: if request.auth.uid == uid;
      match /vehicles/{id} { allow read, write: if request.auth.uid == uid; }
    }
    match /appointments/{id} {
      allow create: if signedIn() && (request.resource.data.customerId == request.auth.uid || request.resource.data.garageId == request.auth.uid);
      allow read, update, delete: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.garageId == request.auth.uid);
    }
    match /inventory/{id} {
      allow create: if signedIn() && request.resource.data.garageId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.garageId == request.auth.uid;
    }
    match /staff/{id} {
      allow create: if signedIn() && request.resource.data.garageId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.garageId == request.auth.uid;
    }
    match /towRequests/{id} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid || roleOf() == 'towDriver');
      allow update: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid || roleOf() == 'towDriver');
    }
  }
}
